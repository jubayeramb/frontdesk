# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres. Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/frontdesk?sslmode=require

# Optional. Only for a local Postgres behind Neon's wsproxy (docker compose).
# DATABASE_WS_PROXY=localhost:5433/v1

# Staff pages (/staff). Generate the secret with: openssl rand -hex 32
STAFF_PASSWORD=change-me-to-something-long
STAFF_SESSION_SECRET=

# Signs the web chat's conversation cookie. Generate with: openssl rand -hex 32
CHAT_COOKIE_SECRET=

# Groq API key for the agent (console.groq.com).
GROQ_API_KEY=
# Optional. Agent turns per UTC day for everyone together (default 250).
# GLOBAL_DAILY_TURN_CAP=250
# Leave unset. The e2e tests point it at their scripted fake.
# GROQ_BASE_URL=

# Kapso (WhatsApp). The API key and phone_number_id come from the Kapso
# dashboard; the webhook secret is shown once when the webhook is created.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# The demo WhatsApp number in international format, digits only. Web visitors
# who ask for a person get a wa.me link to it.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Kapso's inbox embed for /staff. Create it with: pnpm inbox:embed --origin http://localhost:3000 --write-env .env.local
KAPSO_INBOX_EMBED_URL=
