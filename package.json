{
  "name": "frontdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local src/db/seed.ts",
    "db:test:up": "docker compose up -d --wait",
    "db:test:down": "docker compose down -v",
    "agent:chat": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/agent-chat.ts",
    "inbox:embed": "tsx --env-file-if-exists=.env.local scripts/create-inbox-embed.ts",
    "spec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.69",
    "@base-ui/react": "^1.9.0",
    "@kapso/whatsapp-cloud-api": "0.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.150",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fission-ai/openspec": "1.14.3",
    "@next/env": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.18.0"
}
